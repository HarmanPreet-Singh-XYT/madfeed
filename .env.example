# Copy to .env (git-ignored). Never commit real values.
APP_ENV=development
APP_MODE=api
ADDR=:8080
ALLOWED_ORIGINS=http://localhost:3000

# Local development (see README):
# DATABASE_URL=postgres://app_api:dev-api-password@127.0.0.1:54322/app?sslmode=disable
# SUPABASE_JWKS_URL=http://127.0.0.1:9999/jwks.json   # `make devauth`
# JWT_ISSUER=http://localhost:9999
# DAILY_INGEST_MAX_BYTES=5000000
# Production: DATABASE_URL (pooler, restricted role), DATABASE_DIRECT_URL (worker),
# DATABASE_POOLER=true when DATABASE_URL is a transaction-mode pooler.
# Migrations use DATABASE_ADMIN_URL (privileged; never given to the API or worker).

# Filled in during the Phase 0 spike:
# DATABASE_URL=            # app role, NOT the Supabase service_role
# DATABASE_DIRECT_URL=     # direct/session connection for the worker
# SUPABASE_URL=
# (web/.env.local also needs SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY for email-and-password sign-in; the web app does not read this file)
# SUPABASE_PUBLISHABLE_KEY=  # sb_publishable_... (replaces the old anon key); web sign-in only, safe to expose
# The sb_secret_... key (replaces service_role) is never used by this project.
# SUPABASE_JWKS_URL=
# AI providers (add the ones you enable; names only here)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=                                           # embeddings (meaning-based matching and search); also OpenAI transcription if chosen
# EMBED_PROVIDER=off                                        # set to off to disable meaning-based matching even with a key
# EMBED_MODEL=text-embedding-3-small                        # vectors are 512 numbers (EMBED_DIMENSIONS must stay 512)
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_PRICE_PER_MTOKENS_USD=0.02                          # for the cost log
# GOOGLE_API_KEY=            # Gemini
# DEEPSEEK_API_KEY=
# AI_DAILY_BUDGET_USD=5           # per workspace over any 24 hours; AI work waits (nothing fails) once it is used up; 0 turns the cap off
# AI_CONFIG=config/ai.json   # copy api/config/ai.example.json, set real model ids and prices
# RESEND_API_KEY=
# ALERT_WEBHOOK_URL=         # https chat webhook (Slack-compatible) that receives alerts; without it alerts go to the log only
# SECRETS_KEY=               # 32 random bytes, base64 (openssl rand -base64 32). Seals the credentials kept for Slack and GitHub. Lose it and connections must be set up again.
# SLACK_CLIENT_ID=           # the Slack app (api.slack.com/apps): all three, plus SECRETS_KEY and PUBLIC_BASE_URL. Redirect URL to register: <PUBLIC_BASE_URL>/integrations/slack/callback
# SLACK_CLIENT_SECRET=       # Event subscriptions request URL: <PUBLIC_API_URL>/v1/integrations/slack/events (subscribe to message.channels, app_uninstalled, tokens_revoked)
# SLACK_SIGNING_SECRET=
# PUBLIC_API_URL=            # this API's public https address, shown to admins as where GitHub should send notifications
# STRIPE_SECRET_KEY=         # billing: a Stripe test key (sk_test_...) in development; a live key only with APP_ENV=production. Without it everything is included and nothing is billed.
# STRIPE_WEBHOOK_SECRET=     # whsec_..., the signing secret of the endpoint <PUBLIC_API_URL>/v1/webhooks/stripe (events: checkout.session.completed, customer.subscription.created|updated|deleted, invoice.payment_failed, invoice.paid, charge.refunded)
# PLANS_CONFIG=              # path to a JSON file naming the plans, what each includes and its Stripe price id; see docs/plans.example.json. Without it, three unpriced example plans exist and none can be bought.
# METRICS_TOKEN=             # 32+ random characters; a monitoring scraper sends it as a bearer token to /metrics. Empty switches the endpoint off.
# RATE_PUBLIC_PER_MINUTE=60   # per caller address: public pages, forms, unsubscribe links (also RATE_READ_PER_MINUTE=1200, RATE_WRITE_PER_MINUTE=120 per signed-in person; RATE_REGISTER_PER_HOUR=20 new AI assistants per address)
# Transcription: AssemblyAI (preferred when its key is set) or an OpenAI-protocol service
# ASSEMBLYAI_API_KEY=
# ASSEMBLYAI_SPEECH_MODELS=universal-3-5-pro,universal-2   # preference order; leave empty for the vendor's default list
# ASSEMBLYAI_BASE_URL=https://api.assemblyai.com            # https://api.eu.assemblyai.com for EU processing
# TRANSCRIBE_PROVIDER=assemblyai                             # force one when both keys are set (assemblyai or openai)
# SUPPORT_REPLY_TO=support-inbound@mail.example.com # where a customer's answer to a support reply should go (otherwise EMAIL_REPLY_TO)
# SURVEY_MAX_INVITES=2000           # most invitations one survey may have
# SURVEY_PUBLIC_PER_ADDRESS_PER_DAY=10 # new responses one address may start on a public survey link per day
# SURVEY_DAILY_PUBLIC_RESPONSES=2000 # new responses a public survey link takes per day
# (web app) TRUSTED_PROXY_HOPS=1    # set in web/.env.local to the number of proxies in front of the web app; it then passes the visitor's address to the API for survey limits. Set the API's TRUSTED_PROXY_HOPS to count the web app too.
# TRUSTED_PROXY_HOPS=0        # proxies of yours in front of the API (their X-Forwarded-For entries are believed); 0 ignores the header
# RESEND_BASE_URL=           # only for the local mail stand-in (`go run ./cmd/devmail`)
# EMAIL_FROM_ADDRESS=        # a verified sender on your domain
# EMAIL_REPLY_TO=
# RESEND_WEBHOOK_SECRET=      # whsec_...; verifies bounce and complaint reports at POST /v1/webhooks/resend (required in production once email is on)
# Recordings: MEDIA_DIR switches uploads on (development storage on local disk).
# MEDIA_DIR=./.data/media
# Recordings in an S3-compatible bucket instead (for example Supabase Storage > S3 connection). Set all five, and not MEDIA_DIR.
# The access keys can read and write every file in the bucket: backend only, never the web app.
# STORAGE_S3_ENDPOINT=https://<project>.storage.supabase.co/storage/v1/s3
# STORAGE_S3_REGION=
# STORAGE_S3_BUCKET=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# MAX_UPLOAD_BYTES=1073741824     # per file; default 1 GiB
# TRANSCRIBE_MODEL=whisper-1      # a "diarize" model also labels speakers
# TRANSCRIBE_BASE_URL=https://api.openai.com/v1
# TRANSCRIBE_MAX_BYTES=26214400   # the vendor's file size limit; default 25 MB
# TRANSCRIBE_PRICE_PER_MINUTE_USD=  # from the vendor's price list; unset means transcription cost is recorded as unknown (0)
# PUBLIC_BASE_URL=           # web address used in unsubscribe links
# UNSUBSCRIBE_SECRET=        # 32+ random characters; signs unsubscribe links (required in production)

# Web app (web/.env.local, server-side only):
# API_URL=http://127.0.0.1:8080
# ENABLE_DEV_AUTH=true            # local sign-in via `make devauth`; refused when APP_ENV=production
# DEV_AUTH_URL=http://127.0.0.1:9999
