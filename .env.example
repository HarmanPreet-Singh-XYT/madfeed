# Copy to .env (git-ignored). Never commit real values.
APP_ENV=development
APP_MODE=api
ADDR=:8080
ALLOWED_ORIGINS=http://localhost:3000

# Filled in during the Phase 0 spike:
# DATABASE_URL=            # app role, NOT the Supabase service_role
# DATABASE_DIRECT_URL=     # direct/session connection for the worker
# SUPABASE_URL=
# SUPABASE_JWKS_URL=
# AI providers (add the ones you enable; names only here)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=            # Gemini
# DEEPSEEK_API_KEY=
# AI_CONFIG=config/ai.json   # copy api/config/ai.example.json, set real model ids and prices
# RESEND_API_KEY=
