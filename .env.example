# Copy to .env (git-ignored). Never commit real values.
APP_ENV=development
APP_MODE=api
ADDR=:8080
ALLOWED_ORIGINS=http://localhost:3000

# Local development (see README):
# DATABASE_URL=postgres://app_api:dev-api-password@127.0.0.1:54322/app?sslmode=disable
# SUPABASE_JWKS_URL=http://127.0.0.1:9999/jwks.json   # `make devauth`
# JWT_ISSUER=http://localhost:9999
# DAILY_INGEST_MAX_BYTES=5000000
# Production: DATABASE_URL (pooler, restricted role), DATABASE_DIRECT_URL (worker),
# DATABASE_POOLER=true when DATABASE_URL is a transaction-mode pooler.
# Migrations use DATABASE_ADMIN_URL (privileged; never given to the API or worker).

# Filled in during the Phase 0 spike:
# DATABASE_URL=            # app role, NOT the Supabase service_role
# DATABASE_DIRECT_URL=     # direct/session connection for the worker
# SUPABASE_URL=
# (web/.env.local also needs SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY for email-and-password sign-in; the web app does not read this file)
# SUPABASE_PUBLISHABLE_KEY=  # sb_publishable_... (replaces the old anon key); web sign-in only, safe to expose
# The sb_secret_... key (replaces service_role) is never used by this project.
# SUPABASE_JWKS_URL=
# AI providers (add the ones you enable; names only here)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=            # Gemini
# DEEPSEEK_API_KEY=
# AI_DAILY_BUDGET_USD=5           # per workspace over any 24 hours; AI work waits (nothing fails) once it is used up; 0 turns the cap off
# AI_CONFIG=config/ai.json   # copy api/config/ai.example.json, set real model ids and prices
# RESEND_API_KEY=
# ALERT_WEBHOOK_URL=         # https chat webhook (Slack-compatible) that receives alerts; without it alerts go to the log only
# TRUSTED_PROXY_HOPS=0        # proxies of yours in front of the API (their X-Forwarded-For entries are believed); 0 ignores the header
# RESEND_BASE_URL=           # only for the local mail stand-in (`go run ./cmd/devmail`)
# EMAIL_FROM_ADDRESS=        # a verified sender on your domain
# EMAIL_REPLY_TO=
# RESEND_WEBHOOK_SECRET=      # whsec_...; verifies bounce and complaint reports at POST /v1/webhooks/resend (required in production once email is on)
# Recordings: MEDIA_DIR switches uploads on (development storage on local disk).
# MEDIA_DIR=./.data/media
# MAX_UPLOAD_BYTES=1073741824     # per file; default 1 GiB
# TRANSCRIBE_MODEL=whisper-1      # a "diarize" model also labels speakers
# TRANSCRIBE_BASE_URL=https://api.openai.com/v1
# TRANSCRIBE_MAX_BYTES=26214400   # the vendor's file size limit; default 25 MB
# PUBLIC_BASE_URL=           # web address used in unsubscribe links
# UNSUBSCRIBE_SECRET=        # 32+ random characters; signs unsubscribe links (required in production)

# Web app (web/.env.local, server-side only):
# API_URL=http://127.0.0.1:8080
# ENABLE_DEV_AUTH=true            # local sign-in via `make devauth`; refused when APP_ENV=production
# DEV_AUTH_URL=http://127.0.0.1:9999
