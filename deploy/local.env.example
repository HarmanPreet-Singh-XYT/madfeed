# Copy to deploy/local.env. Everything here points at the HOSTED database so the local demo shows
# the same data a judge would see. No production secrets belong in this file.
APP_ENV=development
DATABASE_URL=postgres://<user>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_DIRECT_URL=postgres://<user>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
UNSUBSCRIBE_SECRET=
TRUSTED_PROXY_HOPS=0
AI_CONFIG=config/ai.production.json
NEBIUS_API_KEY=
AI_DAILY_BUDGET_USD=5
TAVILY_API_KEY=
ASSEMBLYAI_API_KEY=
