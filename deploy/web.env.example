# These go in Vercel → Project → Settings → Environment Variables (the web app is not on the VPS).
# Nothing here is a secret: the publishable key is public by design and the browser is meant to see it.

APP_ENV=production

# REQUIRED. The API on the VPS, public https address. The browser never calls this directly.
API_URL=https://api.example.com

# REQUIRED together: without both, sign-in is simply not offered.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Vercel is one hop in front of the Next.js server.
TRUSTED_PROXY_HOPS=1

# Read when the site is built. Empty values show as "not published yet", never invented.
SITE_NAME=madfeed
SITE_URL=https://app.example.com
PUBLIC_WEB_URL=https://app.example.com
CONTACT_EMAIL=
SECURITY_EMAIL=
PRIVACY_EMAIL=
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS=
GOVERNING_LAW=
# LEGAL_REVIEWED=true     # only after a lawyer has read the legal pages

# Off unless set:
# SSO_ENABLED=false
# SSO_PROVIDERS=google,azure
