# Copy to deploy/api.env and fill in. Never commit the filled file.
# APP_ENV=production makes the server refuse to start without the values marked REQUIRED.

APP_ENV=production
APP_MODE=api
ADDR=:8080

# REQUIRED. Session pooler (:5432) or transaction pooler (:6543).
# With :6543 also set DATABASE_POOLER=true; with :5432 leave it unset.
DATABASE_URL=postgres://<user>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_POOLER=true

# REQUIRED. Always the session pooler: the worker needs LISTEN/NOTIFY, which the
# transaction pooler cannot provide. The direct db.<ref>.supabase.co host is IPv6-only.
DATABASE_DIRECT_URL=postgres://<user>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# REQUIRED.
SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
JWT_ISSUER=https://<ref>.supabase.co/auth/v1

# REQUIRED. The web app on Vercel: exact origin, no trailing slash, never "*".
ALLOWED_ORIGINS=https://madfeed.vercel.app
# REQUIRED. Used in unsubscribe and share links: the web app's public https address.
PUBLIC_BASE_URL=https://madfeed.vercel.app
# REQUIRED, 32+ characters: openssl rand -base64 32
UNSUBSCRIBE_SECRET=

# REQUIRED in production. nginx is the only proxy in front of the API.
TRUSTED_PROXY_HOPS=1

# Models. The file ships in the image; the key comes from here.
AI_CONFIG=config/ai.production.json
NEBIUS_API_KEY=
AI_DAILY_BUDGET_USD=5

# Recordings on the volume mounted by compose. Leave empty and set all five
# STORAGE_S3_* values to keep them in Supabase Storage instead.
MEDIA_DIR=/data/media
# STORAGE_S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
# STORAGE_S3_REGION=
# STORAGE_S3_BUCKET=recordings
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# Optional, each switches a feature on:
# TAVILY_API_KEY=            # public-source checks on a request
# ASSEMBLYAI_API_KEY=
# RESEND_API_KEY=            # also needs RESEND_WEBHOOK_SECRET and EMAIL_FROM_ADDRESS
# RESEND_WEBHOOK_SECRET=
# EMAIL_FROM_ADDRESS=
# SECRETS_KEY=               # 32 bytes base64; required to connect Slack or GitHub
# METRICS_TOKEN=
# ALERT_WEBHOOK_URL=
# REDIS_URL=rediss://...
# INTEGRATIONS_ENABLED=slack,github
